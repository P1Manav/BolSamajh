# =====================================================================
# BolSamajh Environment Configuration
# Copy this file to .env and customize values as needed.
# NEVER commit the actual .env file with private credentials.
# =====================================================================

# ---------------------------------------------------------------------
# 1. API Keys & Cloud Fallback
# ---------------------------------------------------------------------
# Google AI Studio API key (optional fallback LLM).
# Get from: https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=

# Google AI Studio model name (default: gemini-3.5-flash).
# BOLSAMAJH_GOOGLE_AI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------------
# 2. Speech-to-Text (STT) Settings
# ---------------------------------------------------------------------
# STT engine: 'faster_whisper'
# BOLSAMAJH_STT_ENGINE=faster_whisper

# STT model size: 'large-v3-turbo' (default for CUDA), 'medium', 'small', 'base', 'tiny'
# BOLSAMAJH_STT_MODEL=large-v3-turbo

# STT device: 'cuda' or 'cpu' (auto-detected if omitted)
# BOLSAMAJH_STT_DEVICE=cuda

# STT language: 'auto' (default: auto-detect), or fixed code: 'hi', 'en', 'gu'
# BOLSAMAJH_STT_LANGUAGE=auto

# ---------------------------------------------------------------------
# 3. Large Language Model (LLM) Settings
# ---------------------------------------------------------------------
# LLM engine: 'ollama' or 'google_ai' (default: ollama)
# BOLSAMAJH_LLM_ENGINE=ollama

# Automatic fallback between Ollama and Gemini (true/false, default: true)
# BOLSAMAJH_LLM_AUTO_FALLBACK=true

# Ollama model tag (default: gemma3:4b)
# BOLSAMAJH_OLLAMA_MODEL=gemma3:4b

# Ollama server base URL (default: http://localhost:11434)
# BOLSAMAJH_OLLAMA_BASE_URL=http://localhost:11434

# Ollama model keep-alive in memory (default: 30m)
# BOLSAMAJH_OLLAMA_KEEP_ALIVE=30m

# ---------------------------------------------------------------------
# 4. Text-to-Speech (TTS) Settings
# ---------------------------------------------------------------------
# TTS engine: 'edge' (Edge-TTS online, default) or 'piper' (100% offline local ONNX)
# BOLSAMAJH_TTS_ENGINE=edge

# Edge-TTS voice for Hindi (default: hi-IN-SwaraNeural)
# BOLSAMAJH_EDGE_VOICE_HI=hi-IN-SwaraNeural

# Edge-TTS voice for Indian English (default: en-IN-NeerjaNeural)
# BOLSAMAJH_EDGE_VOICE_EN=en-IN-NeerjaNeural

# Edge-TTS voice for Gujarati (default: gu-IN-DhwaniNeural)
# BOLSAMAJH_EDGE_VOICE_GU=gu-IN-DhwaniNeural

# Voice for Roman Hinglish text (default: en-IN-NeerjaNeural)
# BOLSAMAJH_ROMAN_VOICE=en-IN-NeerjaNeural

# Custom path to Piper ONNX model file (optional; downloads if empty)
# BOLSAMAJH_PIPER_MODEL_PATH=

# ---------------------------------------------------------------------
# 5. Dictation & Audio Settings
# ---------------------------------------------------------------------
# Target script for dictation: 'natural' (default), 'devanagari', or 'roman'
# BOLSAMAJH_SCRIPT=natural

# Clipboard restoration delay in seconds (default: 0.3)
# BOLSAMAJH_CLIPBOARD_RESTORE_DELAY=0.3

# Headphone mode: false = speaker mode (active echo gate), true = headphone mode
# BOLSAMAJH_HEADPHONE_MODE=false

# Maximum recording duration cap in seconds (default: 120)
# BOLSAMAJH_AUDIO_MAX_RECORD_SECONDS=120

# Optional audio input device index or name substring for sounddevice
# BOLSAMAJH_AUDIO_INPUT_DEVICE=

# ---------------------------------------------------------------------
# 6. Document Q&A (RAG) Settings
# ---------------------------------------------------------------------
# Document Q&A response language: 'hinglish' (default), 'hindi', 'gujarati', 'english', or 'auto'
# BOLSAMAJH_DOC_QA_RESPONSE_LANGUAGE=hinglish

# ---------------------------------------------------------------------
# 7. Desktop Hotkeys (Windows)
# ---------------------------------------------------------------------
# Push-to-talk dictation hotkey (default: alt+shift+space)
# BOLSAMAJH_HOTKEY_DICTATION=alt+shift+space

# Load document hotkey (default: alt+shift+d)
# BOLSAMAJH_HOTKEY_DOC_LOAD=alt+shift+d

# Ask document question hotkey (default: alt+shift+a)
# BOLSAMAJH_HOTKEY_DOC_ASK=alt+shift+a

# Voice command on selected text hotkey (default: alt+shift+c)
# BOLSAMAJH_HOTKEY_COMMAND=alt+shift+c

# Stop speech / cancel recording hotkey (default: escape)
# BOLSAMAJH_HOTKEY_STOP=escape

# Suppress key propagation to active application (true/false, default: false)
# BOLSAMAJH_HOTKEY_SUPPRESS=false

# ---------------------------------------------------------------------
# 8. Web Server & Security Settings
# ---------------------------------------------------------------------
# Allowed HTTP Host headers (comma-separated, default: localhost,127.0.0.1)
# BOLSAMAJH_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional API key for web server endpoints (enforces Authorization header when set)
# BOLSAMAJH_API_KEY=

# Debug logging (true/false, default: false)
# BOLSAMAJH_DEBUG=false
