# =====================================================================
# BolSamajh — Optional GitHub Actions Secrets
# =====================================================================
# Copy this file to 'github_secrets.env' and fill in your values.
# 'github_secrets.env' is strictly git-ignored and will NEVER be committed.
#
# To push these secrets to GitHub in one command:
#   python scripts/set_github_secrets.py
# or using GitHub CLI:
#   gh secret set -f github_secrets.env
# =====================================================================

# 1. Google AI Studio / Gemini API Key (Optional)
# Enables cloud LLM fallback in automated tests and remote builds.
# Get free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 2. Hugging Face Access Token (Optional)
# Prevents rate-limit warnings when CI downloads model checkpoints.
# Get free token at: https://huggingface.co/settings/tokens
HF_TOKEN=

# 3. Android Production Release Keystore (Optional)
# Default CI builds a working debug-signed APK (BolSamajh-Android.apk).
# Only needed if you want release-signing with your private key.
# Generate base64 on Windows:
#   [Convert]::ToBase64String([IO.File]::ReadAllBytes("bolsamajh-release.jks")) | Set-Clipboard
ANDROID_KEYSTORE_BASE64=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=bolsamajh
ANDROID_KEY_PASSWORD=
